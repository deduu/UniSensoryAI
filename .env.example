POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=unisensory
# Manual API/tool connection to this project's Docker PostgreSQL.
# Compose overrides the API container's host to db:5432 automatically.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/unisensory

# ==================== Auth & Multi-tenancy ====================
# When AUTH_ENABLED=false (default), every request is scoped to
# DEFAULT_TENANT_ID. Useful for local dev. When true, the JWT must
# carry `sub` and `tenant_id` claims.
AUTH_ENABLED=false
DEFAULT_TENANT_ID=default
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Session cookie that Authlib uses to persist OAuth state between the
# /login redirect and the /callback. Rotate by changing this.
SESSION_SECRET=change-me-in-production

# Where the backend redirects after a successful OAuth callback.
# In prod, set to your SPA origin, e.g. https://app.example.com
FRONTEND_URL=http://localhost:5173

# Backend base URL used to build the OAuth provider redirect URI. Leave
# empty to derive from the incoming request (fine for local dev).
# In prod, set to your API origin, e.g. https://api.example.com
OAUTH_REDIRECT_BASE_URL=

# Set to "true" in production (HTTPS) so cookies carry the Secure flag.
COOKIE_SECURE=false
# SameSite policy. "lax" works for same-eTLD+1 deployments
# (app.example.com + api.example.com). Use "none" only for truly
# cross-site SPAs; "none" also forces Secure=true.
COOKIE_SAMESITE=lax
# Cookie Domain attribute. Leave empty for host-only (default). Set to
# ".example.com" if you want the cookie sent to multiple subdomains.
COOKIE_DOMAIN=

# Comma-separated list of allowed CORS origins for the SPA.
# In prod: https://app.example.com
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OAuth provider credentials. Leave a pair empty to disable that provider
# (the /v1/auth/login/{provider} endpoint will then return 503).
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ==================== Cloud VLM Providers ====================
# All providers use OpenAI-compatible endpoints via CloudAPIModel.
# Set the API key for whichever provider(s) you use; base URLs are defaults.

# OpenAI (default base URL is https://api.openai.com/v1 — usually leave unset)
OPENAI_API_KEY=
# OPENAI_API_BASE=

# Google Gemini (OpenAI-compatible endpoint)
GOOGLE_API_KEY=

# Together AI
TOGETHER_API_KEY=
TOGETHER_API_BASE=https://api.together.xyz/v1

# Fireworks AI
FIREWORKS_API_KEY=
FIREWORKS_API_BASE=https://api.fireworks.ai/inference/v1

# OpenRouter (aggregator)
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# DeepInfra
DEEPINFRA_API_KEY=
DEEPINFRA_API_BASE=https://api.deepinfra.com/v1/openai

# ==================== Production deployment ====================
# These are consumed by docker-compose.prod.yml and deploy/Caddyfile.
# Leave blank in local dev.

# Public hostname Caddy will serve and obtain a Let's Encrypt cert for.
# e.g. api.example.com — must already have an A record pointing here.
API_DOMAIN=

# Contact email Let's Encrypt uses for expiry notices.
ACME_EMAIL=

# Where uploaded documents are stored on the API container's filesystem.
# Mounted as a docker volume in prod so files survive container rebuilds.
UPLOADS_DIR=./data/uploads

# Docker defaults to the Redis backend. Manual startup defaults to the embedded
# asyncio.Queue (single-instance only) unless QUEUE_BACKEND=redis is selected.
# REDIS_URL=redis://redis:6379/0
# QUEUE_BACKEND=redis

# Deployment-owned PDF OCR and external-schema field extraction profiles.
# Compose selects this file automatically and falls back to OPENAI_API_BASE /
# OPENAI_API_KEY for the endpoint/credential. Library-only use remains native-only.
# Any compatible vision/text model can be selected; PAPER contains no model logic.
# For manual startup, set EXTRACTION_CONFIG_PATH=configs/extraction.yaml.
# EXTRACTION_CONFIG_PATH=/app/configs/extraction.yaml
# EXTRACTION_BASE_URL=https://your-compatible-provider.example/v1
# EXTRACTION_MODEL=gpt-4o
# EXTRACTION_API_KEY=
# Queued full-document OCR deadline (seconds, maximum 3600); individual model calls
# still use the 60-second inference timeout in configs/extraction.yaml.
# EXTRACTION_WORKFLOW_TIMEOUT_SECONDS=1800

# Optional deterministic installment and withholding rules for PAPER.
# Compose selects this host policy; standalone library defaults remain legacy.
# For manual startup, set this to configs/paper_reconciliation.yaml.
# PAPER_RECONCILIATION_CONFIG_PATH=/app/configs/paper_reconciliation.yaml

# Optional contract candidate matching policy (weights, catalog bounds, timeouts).
# Defaults are bundled with src.paper.association; extraction remains model independent.
# PAPER_ASSOCIATION_CONFIG_PATH=/app/configs/paper_association.yaml
# Optional host role-label policy shared by extraction and approval.
# PAPER_PARTY_ROLES_CONFIG_PATH=/app/configs/paper_party_roles.yaml

# Docker dev: cloud-model dependencies are installed by default. Local NVIDIA
# models use docker-compose.gpu.yml; see README for cache/device requirements.
# DOCKER_LOCAL_VLM=false
# HF_CACHE_DIR=./models_cache/huggingface
