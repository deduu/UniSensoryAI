POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=unisensory
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/unisensory

# ==================== Auth & Multi-tenancy ====================
# When AUTH_ENABLED=false (default), every request is scoped to
# DEFAULT_TENANT_ID. Useful for local dev. When true, the JWT must
# carry `sub` and `tenant_id` claims.
AUTH_ENABLED=false
DEFAULT_TENANT_ID=default
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ==================== Cloud VLM Providers ====================
# All providers use OpenAI-compatible endpoints via CloudAPIModel.
# Set the API key for whichever provider(s) you use; base URLs are defaults.

# OpenAI (default base URL is https://api.openai.com/v1 — usually leave unset)
OPENAI_API_KEY=
# OPENAI_API_BASE=

# Google Gemini (OpenAI-compatible endpoint)
GOOGLE_API_KEY=

# Together AI
TOGETHER_API_KEY=
TOGETHER_API_BASE=https://api.together.xyz/v1

# Fireworks AI
FIREWORKS_API_KEY=
FIREWORKS_API_BASE=https://api.fireworks.ai/inference/v1

# OpenRouter (aggregator)
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# DeepInfra
DEEPINFRA_API_KEY=
DEEPINFRA_API_BASE=https://api.deepinfra.com/v1/openai
