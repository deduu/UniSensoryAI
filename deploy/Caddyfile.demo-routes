# Shared by the public gateway and its isolated deployment tests.
route {
    header {
        Cache-Control "no-store"
        X-Content-Type-Options "nosniff"
        Content-Security-Policy "frame-ancestors 'self'"
        Referrer-Policy "same-origin"
        -Server
    }

    basic_auth {
        {$DEMO_USERNAME} {$DEMO_PASSWORD_HASH}
    }

    # Browsers cache Basic credentials. Require the exact origin on writes.
    @foreign_write {
        not method GET HEAD OPTIONS
        not header Origin https://{$DEMO_PUBLIC_IP}
    }
    respond @foreign_write "Same-origin requests required" 403

    @oauth path /v1/auth/login/* /v1/auth/callback/*
    respond @oauth "OAuth is disabled for this shared demo" 404

    request_body {
        max_size 100MB
    }

    @api path /v1 /v1/* /health /openapi.json /docs /docs/* /redoc
    handle @api {
        reverse_proxy api:8010 {
            header_up -Authorization
            flush_interval -1
            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }

    handle {
        root * {$DEMO_STATIC_ROOT:/srv}
        try_files {path} /index.html
        file_server
    }
}
