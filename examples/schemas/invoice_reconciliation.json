{
  "schema_id": "reconciliation.invoice",
  "version": "1",
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "invoice_number": {"type": "string"},
      "po_number": {"type": ["string", "null"]},
      "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
      "subtotal": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
      "tax": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
      "total": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
      "lines": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sku": {"type": "string"},
            "quantity": {"type": "number", "minimum": 0},
            "unit_price": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"}
          },
          "required": ["sku", "quantity", "unit_price"]
        }
      }
    },
    "required": ["invoice_number", "currency", "subtotal", "tax", "total", "lines"]
  }
}
