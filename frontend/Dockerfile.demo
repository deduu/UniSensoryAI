FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# Same-origin requests and shared gateway authentication for this deployment only.
RUN VITE_API_BASE="" VITE_SHARED_DEMO=true npm run build

FROM caddy:2.11.7-alpine
COPY --from=build /app/dist /srv
